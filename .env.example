# Kitsune's Vector account (a dedicated bot key; never commit the real one)
VECTOR_NSEC=nsec1...

# Ollama: local server, or https://ollama.com with OLLAMA_API_KEY for the cloud
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
# OLLAMA_API_KEY=

# NovelAI persistent API token (Account settings -> Get Persistent API Token)
NOVELAI_TOKEN=pst-...
NOVELAI_VOICE_SEED=Aurae
NOVELAI_IMAGE_MODEL=nai-diffusion-4-5-full
NOVELAI_IMAGE_SIZE=portrait

# Channels (name substring or exact id, comma-separated)
KITSUNE_CHAT_CHANNELS=kitsune bot
KITSUNE_IMAGE_CHANNELS=anime image generator

KITSUNE_COMPACT_AFTER=8
KITSUNE_KEEP_RECENT=2
# Her Vector profile (set on startup when it differs)
KITSUNE_SET_PROFILE=true
KITSUNE_NAME=Kitsune
KITSUNE_PREFIX=!
KITSUNE_VIDEO_SIZE=512
KITSUNE_SUBTITLES=true
KITSUNE_LIPSYNC=smooth
KITSUNE_TALKING_VIDEO=true
KITSUNE_DATA_DIR=./data
